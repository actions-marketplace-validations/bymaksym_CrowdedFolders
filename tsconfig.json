{
    // Type-checks everything under src/, tests included, without emitting: tsconfig.build.json emits.
    "compilerOptions": {
        // ES2023 is what Node 20.19, the oldest Node in "engines", runs. The lib stops a newer API
        // (Set#union, Object.groupBy, Promise.withResolvers) from type-checking here and breaking there.
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],

        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "noPropertyAccessFromIndexSignature": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,

        // Sources import each other as `./x.ts`, so Node 24 runs the tests straight from src/; the
        // build rewrites the extensions to `.js`. Only syntax Node can strip is allowed for that.
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
